#!/bin/bash
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_VERSION=1.18.9
OPENCODE_WORKSPACE=
CODE_SERVER_VERSION=4.132.0
VSCODE_WORKSPACE=

# Caddy HTTPS gateway. Point the hostname at this machine in your local DNS.
# The loopback default is deliberately safe, but set this to the host's LAN
# address before accessing the gateway from another device.
HTTPS_GATEWAY_BIND_ADDRESS=
HTTPS_GATEWAY_HOSTNAME=gateway.ai.home.arpa
# LAN DNS resolver for all three gateway namespaces and their service subdomains.
# LAN_DNS_BIND_ADDRESS is the address of the machine currently running lan-dns.
LAN_DNS_BIND_ADDRESS=
LAN_DNS_AI_GATEWAY_ADDRESS=
LAN_DNS_NAS_GATEWAY_ADDRESS=
LAN_DNS_HARDWARE_GATEWAY_ADDRESS=
LAN_DNS_UPSTREAM_SERVER=192.168.50.1
DESKTOP_XFCE_GATEWAY_HOSTNAME=xfce.ai.home.arpa

# ExpressVPN HTTP proxy (gluetun). The user/password are the OpenVPN
# credentials under "Manual configuration" in the ExpressVPN account, not the
# activation code. The server hostname picks the egress country; see
# expressvpn/README.md for the list.
GLUETUN_VERSION=v3.41.3
EXPRESSVPN_OPENVPN_USER=
EXPRESSVPN_OPENVPN_PASSWORD=
EXPRESSVPN_SERVER_HOSTNAME=usa-newyork-ca-version-2.expressnetw.com
# Set to the host's LAN address to accept proxy clients from other machines.
EXPRESSVPN_PROXY_BIND_ADDRESS=
EXPRESSVPN_PROXY_PORT=8888
# Optional proxy Basic Auth; leave both blank for none.
EXPRESSVPN_PROXY_USER=
EXPRESSVPN_PROXY_PASSWORD=

COMFYUI_VERSION=v0.37.0
COMFYUI_TORCH_VERSION=2.11.0
COMFYUI_TORCHVISION_VERSION=0.26.0
COMFYUI_TORCHAUDIO_VERSION=2.11.0
COMFYUI_PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
COMFYUI_MODELS=
COMFYUI_INPUT=
COMFYUI_OUTPUT=
COMFYUI_USER=
COMFYUI_CUSTOM_NODES=
# Optional ComfyUI command-line switches, e.g. --reserve-vram 1.0
COMFYUI_EXTRA_ARGS=
COMFYUI_HF_TOKEN=

DROPBOX_FOLDER=
CALIBRE_LIBRARY=
CALIBRE_SOURCE=
WEBDAV_ROOT=
LASER_CUTTING_ROOT=
MEGANZ_LOCAL=
MEGANZ_REMOTE=

SMB_USERNAME=nas
SMB_PASSWORD=
SMB_PASSWORD_FILE=
SMB_VERSION=3
SMB_MIN_PROTOCOL=
SMB_MAX_PROTOCOL=
SMB_WORKGROUP=WORKGROUP
SMB_NETBIOS_NAME=nas-mini
SMB_SHARE_NAME=mounts
SMB_SHARE_COMMENT="NAS Mounts"
SMB_BROWSEABLE=yes
SMB_WIDE_LINKS=yes


CADDY_HASH=

TRANSMISSION_PASSWORD=

WEBDAV_USERNAME=
WEBDAV_PASSWORD=

OPENHANDS_API_KEY=
OPENHANDS_SECRET_KEY=

LLAMA_CPP_MODELS=
# Optional overrides for the two-card compatibility catalogue and the two
# one-card catalogues. Leave blank to bind-mount the tracked repository files.
LLAMA_CPP_32GB_CONFIG=
LLAMA_CPP_16GB_CONFIG=
LLAMA_CPP_BIND_ADDRESS=
LLAMA_CPP_PORT=11436
LLAMA_CPP_GPU_0_DEVICE_ID=0
LLAMA_CPP_GPU_0_BIND_ADDRESS=
LLAMA_CPP_GPU_0_PORT=11441
LLAMA_CPP_GPU_1_DEVICE_ID=1
LLAMA_CPP_GPU_1_BIND_ADDRESS=
LLAMA_CPP_GPU_1_PORT=11442
# LLAMA_CPP_CONTEXT_LENGTH=131072
LLAMA_CPP_PARALLEL=1
LLAMA_CPP_FIT_TARGET=1024
# Non-secret placeholder required by DSH for the local unauthenticated
# llama.cpp provider. Override only if the server is configured to validate it.
LLAMA_CPP_API_KEY=local
# Leave empty to run Strata without server-side authentication. DeepSeek passes
# a non-secret local placeholder in that case; set a real value here to enable
# Strata authentication and DeepSeek will use the same value.
STRATA_API_KEY=

# Model broker. It is built from its own repository.
MODEL_BROKER_CONTEXT=/mnt/work/projects/model-broker
MODEL_BROKER_BIND_ADDRESS=
MODEL_BROKER_PORT=11460
# Numeric ID of the host group model-broker-control-client, printed by
# install-model-broker-service-control.sh (or: getent group model-broker-control-client).
MODEL_BROKER_CONTROL_GID=

DEEPSEEK_VERSION=0.2.0-rc.2
# Template-only values, used only when directly testing the core `deepseek`
# service with the harness-template profile. Use the project-specific values
# below for normal services.
DEEPSEEK_HOME=
DEEPSEEK_WORKSPACE=
DEEPSEEK_GATEWAY_HOSTNAME=deepseek.ai.home.arpa
# Per-project harness state and explicit trusted gateway hostnames. The Amiga
# defaults intentionally retain the historic DEEPSEEK_HOME/WORKSPACE paths.
DEEPSEEK_AMIGA_HOME=
DEEPSEEK_AMIGA_WORKSPACE=
DEEPSEEK_AMIGA_GATEWAY_HOSTNAME=deepseek-amiga.ai.home.arpa
PI_AMIGA_HOME=
PI_AMIGA_WORKSPACE=
DEEPSEEK_XBOX360_HOME=
DEEPSEEK_XBOX360_WORKSPACE=
DEEPSEEK_XBOX360_GATEWAY_HOSTNAME=deepseek-xbox360.ai.home.arpa
PI_XBOX360_HOME=
PI_XBOX360_WORKSPACE=

# Xbox 360 project: pinned Xenia Canary release and upstream asset SHA-256s.
# Change all three together when deliberately updating the project image.
XENIA_CANARY_RELEASE=cc4981a
XENIA_CANARY_LINUX_SHA256=82914b57c0f673e39e7e43ffe4a0222088520f35e2a05b20ad43a586f811455c
XENIA_CANARY_WINDOWS_SHA256=46d531e3cdc5ab0144509a780005f4736df62264150c49e52bcd2545ef6bf2fc

SEARXNG_TAG=latest
SEARXNG_BIND_ADDRESS=
SEARXNG_PORT=9036
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

GS_LLAMA_CPP_16GB_CUDA_VISIBLE_DEVICES=1
# Second one-GPU GenerelSchwerz instance; keep it on the other physical card.
GS_LLAMA_CPP_16GB_GPU_0_CUDA_VISIBLE_DEVICES=0
GS_LLAMA_CPP_16GB_GPU_0_BIND_ADDRESS=
GS_LLAMA_CPP_16GB_GPU_0_PORT=11443
