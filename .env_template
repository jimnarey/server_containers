#!/bin/bash
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_VERSION=1.18.9
OPENCODE_WORKSPACE=
CODE_SERVER_VERSION=4.132.0
VSCODE_WORKSPACE=

# Caddy HTTPS gateway. Point the hostname at this machine in your local DNS.
# The loopback default is deliberately safe, but set this to the host's LAN
# address before accessing the gateway from another device.
HTTPS_GATEWAY_BIND_ADDRESS=
HTTPS_GATEWAY_HOSTNAME=gateway.ai.home.arpa
# LAN DNS resolver for all three gateway namespaces and their service subdomains.
# LAN_DNS_BIND_ADDRESS is the address of the machine currently running lan-dns.
LAN_DNS_BIND_ADDRESS=
LAN_DNS_AI_GATEWAY_ADDRESS=
LAN_DNS_NAS_GATEWAY_ADDRESS=
LAN_DNS_HARDWARE_GATEWAY_ADDRESS=
LAN_DNS_UPSTREAM_SERVER=192.168.50.1
DESKTOP_XFCE_GATEWAY_HOSTNAME=xfce.ai.home.arpa

COMFYUI_VERSION=v0.29.2
COMFYUI_TORCH_VERSION=2.11.0
COMFYUI_TORCHVISION_VERSION=0.26.0
COMFYUI_TORCHAUDIO_VERSION=2.11.0
COMFYUI_PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
COMFYUI_BIND_ADDRESS=
COMFYUI_PORT=9034
COMFYUI_MODELS=
COMFYUI_INPUT=
COMFYUI_OUTPUT=
COMFYUI_USER=
COMFYUI_CUSTOM_NODES=
# Optional ComfyUI command-line switches, e.g. --reserve-vram 1.0
COMFYUI_EXTRA_ARGS=
COMFYUI_HF_TOKEN=

DROPBOX_FOLDER=
CALIBRE_LIBRARY=
CALIBRE_SOURCE=
WEBDAV_ROOT=
LASER_CUTTING_ROOT=
MEGANZ_LOCAL=
MEGANZ_REMOTE=


CADDY_HASH=

TRANSMISSION_PASSWORD=

WEBDAV_USERNAME=
WEBDAV_PASSWORD=

OPENHANDS_API_KEY=
OPENHANDS_SECRET_KEY=

LLAMA_CPP_MODELS=
LLAMA_CPP_BIND_ADDRESS=
LLAMA_CPP_PORT=11436
LLAMA_CPP_GPU_0_DEVICE_ID=0
LLAMA_CPP_GPU_0_BIND_ADDRESS=
LLAMA_CPP_GPU_0_PORT=11441
LLAMA_CPP_GPU_1_DEVICE_ID=1
LLAMA_CPP_GPU_1_BIND_ADDRESS=
LLAMA_CPP_GPU_1_PORT=11442
# Must contain every physical GPU exposed by llama-cpp-all-gpus.
LLAMA_CPP_ALL_GPU_LOCK_IDS=0,1
# LLAMA_CPP_CONTEXT_LENGTH=131072
LLAMA_CPP_PARALLEL=1
LLAMA_CPP_FIT_TARGET=1024

DEEPSEEK_VERSION=0.1.1-rc.2
DEEPSEEK_HOME=
DEEPSEEK_WORKSPACE=
# DNS name served by the HTTPS gateway; add a local DNS record for it.
DEEPSEEK_GATEWAY_HOSTNAME=deepseek.ai.home.arpa

SEARXNG_TAG=latest
SEARXNG_BIND_ADDRESS=
SEARXNG_PORT=9036
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

GS_LLAMA_CPP_16GB_CUDA_VISIBLE_DEVICES=1
# Second one-GPU GenerelSchwerz instance; keep it on the other physical card.
GS_LLAMA_CPP_16GB_GPU_0_CUDA_VISIBLE_DEVICES=0
GS_LLAMA_CPP_16GB_GPU_0_BIND_ADDRESS=
GS_LLAMA_CPP_16GB_GPU_0_PORT=11443
