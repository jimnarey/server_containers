# ComfyUI's own Caddy instance matches DeepSeek's authentication boundary:
# it remains private behind the HTTPS gateway and authenticates every request
# before proxying to the loopback-only ComfyUI server.
:8081 {
    log
    reverse_proxy 127.0.0.1:8080
    basicauth /* {
        {env.CADDY_USER} {env.CADDY_HASH}
    }
}
