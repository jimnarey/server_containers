# This gateway terminates LAN HTTPS and routes to explicitly opted-in services.
# Service-level authentication stays in the service, not in this gateway.
{
	admin off

	# Each host gets a distinct root subject.  Docker supplies HOSTNAME from the
	# machine hostname (see compose.network.yml), rather than its ephemeral
	# container hostname.
	pki {
		ca local {
			name "Caddy {$HOSTNAME} Local Authority"
		}
	}
}

https://{$HTTPS_GATEWAY_HOSTNAME} {
	# Use Caddy's local CA for a LAN-only name. Clients must trust its root;
	# installation instructions are in README.md.
	tls internal

	respond "HTTPS gateway is running." 200
}

https://{$DEEPSEEK_GATEWAY_HOSTNAME} {
	tls internal
	reverse_proxy deepseek:8081
}

# desktop-xfce retains its own Caddy Basic Auth. This gateway provides only
# the TLS certificate and service-name routing.
https://{$DESKTOP_XFCE_GATEWAY_HOSTNAME} {
	tls internal
	reverse_proxy desktop-xfce:8081
}
