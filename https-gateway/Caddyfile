# This gateway terminates LAN HTTPS and routes to explicitly opted-in services.
# Service-level authentication stays in the service, not in this gateway.
{
	# The CA root is installed on client machines, not into this minimal gateway
	# container. Avoid a misleading error on every dynamic configuration reload.
	skip_install_trust

	# Each host gets a distinct root subject. Compose reads HOSTNAME from the
	# gateway machine's /etc/hostname, rather than Docker's ephemeral container
	# hostname.
	pki {
		ca local {
			name "Caddy {$HOSTNAME} Local Authority"
		}
	}
}

https://{$HTTPS_GATEWAY_HOSTNAME} {
	# Use Caddy's local CA for a LAN-only name. Clients must trust its root;
	# installation instructions are in README.md.
	tls internal

	respond "HTTPS gateway is running." 200
}

# Application routes are generated from caddy.* labels on services which join
# the private https-gateway network. Caddy's admin endpoint remains private
# inside this container because caddy-docker-proxy needs it to hot-reload.
