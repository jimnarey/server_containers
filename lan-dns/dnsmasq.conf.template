# Docker publishes host TCP/UDP port 53 to this unprivileged container port.
port=5353
listen-address=0.0.0.0
bind-interfaces

# Resolve the home-server gateway namespace locally. This covers the apex and
# every subdomain, for example deepseek.ai.home.arpa and xfce.ai.home.arpa.
local=/ai.home.arpa/
address=/ai.home.arpa/@LAN_DNS_GATEWAY_ADDRESS@

# Forward all other lookups to the router (or another chosen recursive DNS
# resolver). Do not inherit Docker's generated resolv.conf.
no-resolv
server=@LAN_DNS_UPSTREAM_SERVER@

domain-needed
bogus-priv
cache-size=1000
