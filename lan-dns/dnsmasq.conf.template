# Docker publishes host TCP/UDP port 53 to this unprivileged container port.
port=5353
listen-address=0.0.0.0
bind-interfaces

# Resolve each home-server gateway namespace locally. Each rule covers its
# apex and every subdomain, for example deepseek.ai.home.arpa and
# xfce.nas.home.arpa. DNS selects the gateway host; Caddy selects the service.
local=/ai.home.arpa/
address=/ai.home.arpa/@LAN_DNS_AI_GATEWAY_ADDRESS@
local=/nas.home.arpa/
address=/nas.home.arpa/@LAN_DNS_NAS_GATEWAY_ADDRESS@
local=/hardware.home.arpa/
address=/hardware.home.arpa/@LAN_DNS_HARDWARE_GATEWAY_ADDRESS@

# Forward all other lookups to the router (or another chosen recursive DNS
# resolver). Do not inherit Docker's generated resolv.conf.
no-resolv
server=@LAN_DNS_UPSTREAM_SERVER@

domain-needed
bogus-priv
cache-size=1000
